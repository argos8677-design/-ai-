# Public Supabase settings (safe for local dev; Lovable Cloud injects secrets on deploy)
# GitHub Pages: publishable values also go in .env.production (committed). Run supabase/migrations/*.sql on the SAME project ref.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Do not commit real values. Lovable Cloud provides server-only keys at runtime:
# SUPABASE_SERVICE_ROLE_KEY, LOVABLE_API_KEY

# GitHub Pages + Supabase Edge: set on Dashboard → Edge Functions → marketing → Secrets:
# LOVABLE_API_KEY or OPENAI_API_KEY
